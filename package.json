{
  "name": "agent-factory",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A governed 100-role mythic Codex agent command center.",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "validate": "node scripts/validate-catalog.mjs",
    "test": "node scripts/test-catalog.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:security": "node scripts/test-security.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.65.1"
  }
}
